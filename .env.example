# Plataforma IsoTools (Railway) — nunca se corre nada de eso en local, solo
# le hablamos por HTTP.
CORE_BASE_URL=https://isotools-production.up.railway.app/api/v1
API_KEY=

# Tu propia base de datos (docker compose up -d), SOLO para el bookkeeping de
# esta tool (templates, inspecciones, seguimientos, cursor de polling). No es
# el Postgres de la plataforma — no tienes ni necesitas acceso a ese.
DATABASE_URL=postgresql://toolvf:toolvf@localhost:5435/tool_vision_followups

# Cada cuánto se hace polling a /events/subscriptions/:toolId
POLL_INTERVAL_MS=5000
